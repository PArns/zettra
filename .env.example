# Copy to .env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=zettra
POSTGRES_PASSWORD=change_me
POSTGRES_DB=zettra

# Connection string used by server + collab.
# Host is the compose service name `postgres`.
DATABASE_URL=postgresql://zettra:change_me@postgres:5432/zettra?schema=public

# --- Redis (BullMQ + Hocuspocus pubsub) ---
REDIS_URL=redis://redis:6379

# --- Ollama (local embeddings + local LLM) ---
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
# Local reasoning/tagging model. Use a Q4_K_M+ quant, not a heavy IQ3 quant, or
# structured/JSON output quality degrades badly. Alternatives: llama3.1:8b, mistral-small.
# ollama-pull fetches this on first boot. On a 16 GB RTX 5080, a 7B instruct model is ideal.
LLM_MODEL=qwen2.5:7b-instruct
# GPU: run with `-f docker-compose.gpu.yml` to give Ollama the NVIDIA card (see that file).

# --- Claude (remote escalation for reasoning / curation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
# Long random secret, e.g. `openssl rand -hex 32`.
APP_SECRET=change_me_to_a_long_random_secret
# Public URL of the `web` entrypoint.
APP_URL=http://localhost:8080

# --- Auth (§2) ---
# `legacy` = built-in email+password JWT flow (default). `better-auth` = mount Better Auth at
# /api/auth/* (email+password, Google/Apple social login, admin + organization plugins).
# After switching, create its tables once: `npx @better-auth/cli migrate` (uses DATABASE_URL).
AUTH_PROVIDER=legacy
# Session signing secret for Better Auth (falls back to APP_SECRET). `openssl rand -hex 32`.
BETTER_AUTH_SECRET=change_me_to_a_long_random_secret
# Public base URL Better Auth serves from (defaults to $APP_URL/api/auth).
# BETTER_AUTH_URL=https://app.example.com/api/auth
# Comma-separated origins allowed to call auth (defaults to $APP_URL).
# AUTH_TRUSTED_ORIGINS=https://app.example.com
# Social login — providers activate only when both id + secret are set.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Apple needs a paid Apple Developer account + a "Sign in with Apple" key (client secret is a JWT).
# APPLE_CLIENT_ID=...
# APPLE_CLIENT_SECRET=...
# Published host port for the public `web` entrypoint. On Coolify you usually leave this and
# let Coolify's proxy map your domain to the container's port 80 instead.
WEB_PORT=8080

# --- Internal service wiring (used by docker-compose) ---
# HTTP port the NestJS API listens on inside its container (env-configurable).
PORT=3000
# WebSocket port the Hocuspocus collab server listens on inside its container.
COLLAB_PORT=1234
# Base URL the collab server uses to call the API's internal sync endpoint.
SERVER_INTERNAL_URL=http://server:3000
# Debounce (ms) before a settled Yjs doc is projected to rows.
PERSIST_DEBOUNCE_MS=2000
# Directory for uploaded files (mounted volume in prod).
UPLOAD_DIR=/data/uploads
# Run the in-process BullMQ workers alongside the API (set false for a dedicated worker).
RUN_WORKERS=true

# --- OCR pass on uploaded images (optional) ---
# When true, raster images in a block are recognized and their text folded into search (§5/§6).
OCR_ENABLED=true
# Backend: `tesseract` (bundled dep, CPU, small memory — recommended) or `ollama` (a vision model).
# Prefer tesseract unless you have RAM to spare beside the LLM: a 7B vision model OOMs a 7.6 GB box.
OCR_BACKEND=tesseract
# tesseract only: recognition languages (codes joined by +).
OCR_LANGUAGES=eng+deu
# ollama only: the vision model to prompt (must be pulled in Ollama), e.g. llama3.2-vision, llava:7b.
# OCR_VISION_MODEL=llava:7b

# --- IMAP capture source (optional; poller idle unless IMAP_HOST is set) ---
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_TLS=true
# IMAP_USER=inbox@example.com
# IMAP_PASSWORD=app_password
# IMAP_POLL_INTERVAL_MS=60000
# Which workspace captured emails land in (per-mailbox mapping for v1):
# IMAP_TENANT_ID=...
# IMAP_SPACE_ID=...
# IMAP_OWNER_USER_ID=...
